# ============================================================
# QA Agent System - Конфигурация
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=qwen3.8
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ── Rules ────────────────────────────────────────────────────
RULES_FILE_PATH=rules/doqa_rules.md

# ── Requirements source ──────────────────────────────────────
REQUIREMENTS_SOURCE_TYPE=folder
REQUIREMENTS_FOLDER_PATH=./requirements
REQUIREMENTS_SCAN_RECURSIVE=true
REQUIREMENTS_FILE_MASKS=*.md,*.txt,*.doc,*.docx,*.xls,*.xlsx,*.xlsm,*.csv,*.json,*.yaml,*.yml

# ── Repository source ────────────────────────────────────────
REQUIREMENTS_REPO_URL=
REQUIREMENTS_BRANCH=main
REQUIREMENTS_PATH=

# ── Redmine ──────────────────────────────────────────────────
REDMINE_BASE_URL=
REDMINE_API_KEY=
REDMINE_PROJECT_ID=

# ── DoQA ─────────────────────────────────────────────────────
DOQA_BASE_URL=
DOQA_API_VERSION=4.3.1
DOQA_API_TOKEN=
DOQA_TIMEOUT=60
DOQA_MAX_RETRIES=3
DOQA_IMPORT_MODE=file
DOQA_REVIEW_STATUS_NAME=Ревью
DOQA_ARCHIVE_STATUS_NAME=Архив
DOQA_REVIEW_STATUS_ID=
DOQA_ARCHIVE_STATUS_ID=

# ── Codebase ─────────────────────────────────────────────────
CODEBASE_ACCESS_MODE=external_agent
CODEBASE_AGENT_URL=
CODEBASE_AGENT_TIMEOUT=120

# ── Human review ─────────────────────────────────────────────
HUMAN_REVIEW_MODE=web_ui
HUMAN_REVIEW_CLI_ENABLED=true
MAX_STAGE_ITERATIONS=5

# ── Workspace ────────────────────────────────────────────────
WORKSPACE_DIR=./workspace
