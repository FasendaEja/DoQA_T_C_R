# ============================================================
# Конфигурация DoQA Review Tool
# Скопируйте в .env и заполните значения
# ============================================================

# ── Подключение к DoQA ───────────────────────────────────────
DOQA_BASE_URL=https://app.doqa.app
DOQA_API_TOKEN=

# ── Источник тест-кейсов ─────────────────────────────────────
# Режим получения тест-кейсов: api или file
DOQA_MODE=api

# Для режима api:
DOQA_SPACE_ID=
DOQA_CASE_IDS=

# Для режима file:
# Поместите файлы экспорта DoQA (xlsx) в папку input/
# Утилита обработает все файлы из папки и удалит их после обработки
INPUT_DIR=input

# ── Настройки ИИ ─────────────────────────────────────────────
# Базовый URL API (без /chat/completions — SDK добавит сам)
# Qwen3.8 (Alibaba Cloud): замените {WorkspaceId} на ваш ID
AI_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# Ollama (локально):
# AI_BASE_URL=http://localhost:11434/v1
# OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1

# API-ключ провайдера ИИ
AI_API_KEY=

# Модель ИИ
AI_MODEL=qwen3.8-max

# Таймаут ожидания ответа ИИ в секундах (по умолчанию 120)
AI_TIMEOUT=120

# Максимальное количество попыток при ошибке (по умолчанию 3)
AI_MAX_RETRIES=3

# Альтернативные провайдеры:
# OpenAI:    https://api.openai.com/v1/chat/completions
# YandexGPT: https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# GigaChat:  https://gigachat.devices.sberbank.ru/api/v1/chat/completions
# Ollama:    http://localhost:11434/v1/chat/completions

# ── Файлы ────────────────────────────────────────────────────
PROMPT_FILE=prompt.txt
RULES_FILE=DoQA_test_case_review_rules_.txt
OUTPUT_DIR=review_results
