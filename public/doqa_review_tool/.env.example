# ============================================================
# Конфигурация утилиты ревью тест-кейсов DoQA
# Скопируйте этот файл в .env и заполните значения
# ============================================================

# ------------------------------------------------------------
# Подключение к DoQA
# ------------------------------------------------------------

# Базовый URL экземпляра DoQA
# Для облака: https://app.doqa.app
# Для box-версии: адрес вашего сервера, например https://doqa.your-company.com
DOQA_BASE_URL=https://app.doqa.app

# Персональный API-токен DoQA
# Получить: Профиль → API-токены → Создать API-токен
# ВАЖНО: токен показывается только один раз при создании!
DOQA_API_TOKEN=

# ------------------------------------------------------------
# Параметры запуска (используются при запуске без аргументов CLI)
# ------------------------------------------------------------

# Режим получения тест-кейсов: api или file
DOQA_MODE=api

# ID пространства DoQA (для режима api)
DOQA_SPACE_ID=

# Список ID тест-кейсов через запятую (для обоих режимов)
# Если пусто — в режиме file будут обработаны все кейсы из файла
DOQA_CASE_IDS=

# Путь к файлу экспорта DoQA (для режима file)
DOQA_FILE=

# ------------------------------------------------------------
# Настройки ИИ
# ------------------------------------------------------------

# URL API провайдера ИИ
# Выберите ОДИН из вариантов ниже (остальные закомментируйте):

# OpenAI (GPT-4o, GPT-4, GPT-3.5-turbo)
# AI_API_URL=https://api.openai.com/v1/chat/completions

# Qwen3.8 через Alibaba Cloud Model Studio (DashScope)
# ВАЖНО: замените {WorkspaceId} на ваш ID рабочего пространства
# Регионы: ap-southeast-1 (Сингапур), us-east-1 (Вирджиния), cn-beijing (Пекин), cn-hongkong
AI_API_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# Qwen3.8 (альтернативный URL — legacy dashscope)
# AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# YandexGPT (облако Yandex)
# AI_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# GigaChat (Сбер)
# AI_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# Ollama (локальные модели)
# AI_API_URL=http://localhost:11434/v1/chat/completions

# OpenRouter (агрегатор моделей)
# AI_API_URL=https://openrouter.ai/api/v1/chat/completions

# Кастомный OpenAI-совместимый API
# AI_API_URL=https://your-provider.com/v1/chat/completions

# API-ключ провайдера ИИ
# Для Qwen: получите DASHSCOPE_API_KEY в консоли Alibaba Cloud Model Studio
# https://modelstudio.console.alibabacloud.com/model/settings/api-key
AI_API_KEY=

# Модель ИИ
# Выберите ОДИН из вариантов ниже (остальные закомментируйте):

# Qwen3.8 (Alibaba Cloud)
AI_MODEL=qwen3.8-max
# AI_MODEL=qwen3.8-flash

# OpenAI
# AI_MODEL=gpt-4o
# AI_MODEL=gpt-4o-mini
# AI_MODEL=gpt-4-turbo

# YandexGPT
# AI_MODEL=yandexgpt
# AI_MODEL=yandexgpt-lite

# GigaChat
# AI_MODEL=GigaChat
# AI_MODEL=GigaChat-Pro

# Ollama (локальные модели)
# AI_MODEL=llama3
# AI_MODEL=mistral

# OpenRouter
# AI_MODEL=anthropic/claude-3.5-sonnet
# AI_MODEL=google/gemini-pro

# ------------------------------------------------------------
# Файлы
# ------------------------------------------------------------

# Путь к файлу с промтом для ИИ
PROMPT_FILE=prompt.txt

# Путь к файлу с правилами ревью
RULES_FILE=DoQA_test_case_review_rules.txt

# Директория для сохранения результатов ревью
OUTPUT_DIR=review_results
