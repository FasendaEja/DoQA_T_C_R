# ============================================================
# Конфигурация утилиты ревью тест-кейсов DoQA
# Скопируйте этот файл в .env и заполните значения
# ============================================================

# ------------------------------------------------------------
# Подключение к DoQA
# ------------------------------------------------------------

# Базовый URL экземпляра DoQA
# Для облака: https://app.doqa.app
# Для box-версии: адрес вашего сервера, например https://doqa.your-company.com
DOQA_BASE_URL=https://app.doqa.app

# Персональный API-токен DoQA
# Получить: Профиль → API-токены → Создать API-токен
# ВАЖНО: токен показывается только один раз при создании!
DOQA_API_TOKEN=

# ------------------------------------------------------------
# Параметры запуска (используются при запуске без аргументов CLI)
# ------------------------------------------------------------

# Режим получения тест-кейсов: api или file
DOQA_MODE=api

# ID пространства DoQA (для режима api)
DOQA_SPACE_ID=

# Список ID тест-кейсов через запятую (для обоих режимов)
# Если пусто — в режиме file будут обработаны все кейсы из файла
DOQA_CASE_IDS=

# Путь к файлу экспорта DoQA (для режима file)
DOQA_FILE=

# ------------------------------------------------------------
# Настройки ИИ (OpenAI-совместимый API)
# ------------------------------------------------------------

# URL API провайдера ИИ
# OpenAI:    https://api.openai.com/v1/chat/completions
# YandexGPT: https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# GigaChat:  https://gigachat.devices.sberbank.ru/api/v1/chat/completions
AI_API_URL=https://api.openai.com/v1/chat/completions

# API-ключ провайдера ИИ
AI_API_KEY=

# Модель ИИ
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# YandexGPT: yandexgpt, yandexgpt-lite
# GigaChat: GigaChat, GigaChat-Pro
AI_MODEL=gpt-4o

# ------------------------------------------------------------
# Файлы
# ------------------------------------------------------------

# Путь к файлу с промтом для ИИ
PROMPT_FILE=prompt.txt

# Путь к файлу с правилами ревью
RULES_FILE=DoQA_test_case_review_rules.txt

# Директория для сохранения результатов ревью
OUTPUT_DIR=review_results
