# ============================================================
# Конфигурация DoQA Review Tool
# Скопируйте в .env и заполните значения
# ============================================================

# ── Подключение к DoQA ───────────────────────────────────────
DOQA_BASE_URL=https://app.doqa.app
DOQA_API_TOKEN=

# ── Источник тест-кейсов ─────────────────────────────────────
# Режим: api или file
DOQA_MODE=api

# Для режима api:
DOQA_SPACE_ID=
DOQA_CASE_IDS=

# Для режима file:
INPUT_DIR=input

# ── Настройки ИИ ─────────────────────────────────────────────
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# ── Файлы ────────────────────────────────────────────────────
PROMPT_FILE=prompt.txt
RULES_FILE=DoQA_test_case_review_rules_.txt
OUTPUT_DIR=review_results
