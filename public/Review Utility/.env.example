# ============================================================
# Конфигурация DoQA Review Tool
# Скопируйте в .env и заполните значения
# ============================================================

# ── Источник тест-кейсов ─────────────────────────────────────
# Поместите файлы экспорта DoQA (xlsx) в папку input/
# Утилита обработает все файлы из папки и удалит их после обработки
INPUT_DIR=input

# ── Настройки ИИ ─────────────────────────────────────────────
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# ── Файлы ────────────────────────────────────────────────────
PROMPT_FILE=prompt.txt
RULES_FILE=DoQA_test_case_review_rules_.txt
OUTPUT_DIR=review_results
