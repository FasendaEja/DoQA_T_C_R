# ============================================================
# Конфигурация DoQA Review Tool
# Скопируйте в .env и заполните значения
# ============================================================

# ── Режим работы ─────────────────────────────────────────────
# file   — обработка файлов из папки input/
# export — экспорт кейсов из DoQA через API
MODE=file

# ── Настройки DoQA API (для режима export) ───────────────────
DOQA_BASE_URL=https://app.doqa.app
DOQA_API_TOKEN=
DOQA_SPACE_ID=

# Вариант работы режима export:
# ids     — экспорт по списку ID кейсов (ввод из консоли)
# filters — экспорт по фильтрам
EXPORT_MODE=filters

# Фильтры для режима export (EXPORT_MODE=filters):
# Статусы: ready, draft, archived, broken (через запятую)
DOQA_STATUSES=draft,broken,review

# ID авторов (через запятую)
DOQA_CREATOR_IDS=

# ID ответственных лиц (через запятую)
DOQA_RESPONSIBLE_IDS=

# ID папок (через запятую)
DOQA_FOLDER_IDS=

# ID тегов (через запятую)
DOQA_TAG_IDS=

# ID атрибутов (через запятую)
DOQA_ATTRIBUTE_IDS=

# Приоритеты: low, medium, high (через запятую)
DOQA_PRIORITIES=

# Полнотекстовый поиск
DOQA_SEARCH=

# Фильтр по дате изменения:
# 1 — не используется
# 2 — последние сутки
# 3 — последний час
DOQA_CHANGED_AT_FILTER=1

# Фильтр по дате создания (ISO 8601 формат)
DOQA_CREATED_AT_FROM=
DOQA_CREATED_AT_TO=

# Сортировка: id, title, creatorId, createdAt, changedAt, priority, status, tag
DOQA_SORT=

# Направление сортировки: asc, desc
DOQA_DIRECTION=

# Статусы автоматизации: manual, planned, automated (через запятую)
DOQA_AUTOMATION_STATUSES=

# Источники создания: manual, autotest (через запятую)
DOQA_CREATION_SOURCES=

# ── Настройки ИИ ─────────────────────────────────────────────
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# ── Файлы ────────────────────────────────────────────────────
PROMPT_FILE=prompt.txt
RULES_FILE=DoQA_test_case_review_rules_.txt
OUTPUT_DIR=review_results
